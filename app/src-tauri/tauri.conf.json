{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hexgate Swap",
  "version": "0.2.2",
  "identifier": "com.yaniss.lolswitcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sidecar:build && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hexgate Swap",
        "width": 720,
        "height": 600,
        "minWidth": 620,
        "minHeight": 460,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "Hexgate Overlay",
        "url": "overlay.html",
        "width": 260,
        "height": 70,
        "x": 1250,
        "y": 20,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "overlay_cd",
        "title": "Hexgate Overlay Cooldowns",
        "url": "overlay-cd.html",
        "width": 320,
        "height": 150,
        "x": 1190,
        "y": 110,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/hexgate-backend/**/*"]
  }
}
